{
  "name": "stocksense",
  "version": "0.1.0",
  "private": true,
  "description": "StockSense — modular Inventory Management System (IMS)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run prisma:migrate --workspace backend",
    "db:seed": "npm run prisma:seed --workspace backend",
    "up": "docker compose up --build",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"{backend,frontend}/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
