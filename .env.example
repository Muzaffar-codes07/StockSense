# Shared Postgres credentials (used by docker-compose and the API)
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=stocksense
POSTGRES_DB=stocksense

# Connection string the API uses (host = 'db' inside docker-compose, 'localhost' when running the API locally)
DATABASE_URL=postgresql://stocksense:stocksense@localhost:5432/stocksense?schema=public

# Auth
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PORT=3000

# Web
VITE_API_URL=http://localhost:3000
